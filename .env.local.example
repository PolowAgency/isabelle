# --- Base de données (lib/db.ts) ---------------------------------------
# Connexion Postgres standard. En phase de test : chaîne "connection pooling"
# (port 6543) du projet Supabase. Après migration HDS : chaîne fournie par
# Scaleway/OVHcloud.
#
# IMPORTANT : le rôle utilisé ici doit être le rôle restreint `isabelle_app`
# (scripts/create-app-role.sql) : ni superuser, ni BYPASSRLS, ni propriétaire des
# tables. En production l'application REFUSE de démarrer sinon (npm run check:rls
# pour vérifier). Les migrations et scripts d'administration utilisent le rôle
# propriétaire (DATABASE_URL_OWNER ci-dessous), jamais celui-ci.
DATABASE_URL=

# Rôle propriétaire : uniquement pour les scripts (migrations, chiffrement des
# données existantes, sauvegarde). Ne jamais l'exposer à l'application déployée.
DATABASE_URL_OWNER=

# --- Chiffrement des codes d'accès au domicile (lib/crypto.ts) ------------
# Clé AES-256 en base64 : openssl rand -base64 32
# Jamais en base, jamais dans le dépôt. La PERDRE rend les codes illisibles :
# la sauvegarder séparément (gestionnaire de secrets).
DATA_ENCRYPTION_KEY=
# Rotation : anciennes clés (séparées par des virgules) encore lisibles, le temps
# de relancer `npm run encrypt:existing` avec la nouvelle clé courante.
DATA_ENCRYPTION_KEY_PREVIOUS=

# --- Stockage fichiers (lib/storage.ts) ---------------------------------
# SDK S3 générique. En phase de test : endpoint S3-compatible de Supabase
# Storage. Après migration HDS : Scaleway Object Storage / OVHcloud Object
# Storage. 
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- Auth (src/auth.ts) --------------------------------------------------
# Signe les sessions JWT et sert de secret aux empreintes (email, IP) des
# compteurs de connexion. Générer avec: openssl rand -base64 33
AUTH_SECRET=

# --- Démo -----------------------------------------------------------------
# NE PAS activer en production (ignoré si NODE_ENV=production). Mettre à true
# seulement pour travailler sans base : comptes fictifs, mot de passe quelconque.
DEMO_MODE=false
